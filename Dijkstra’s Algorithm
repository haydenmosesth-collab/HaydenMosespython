import heapq

def dijkstra(graph, start):
    """
    Finds the shortest distance from the start node to all other nodes in a graph.
    
    :param graph: A dictionary representing the adjacency list. 
                  Format: { node: [(neighbor, weight), ...] }
    :param start: The starting/source node.
    :return: A dictionary containing the shortest distance to each node.
    """
    # Initialize distances to infinity for all nodes
    distances = {node: float('inf') for node in graph}
    # Distance to the source node itself is always 0
    distances[start] = 0
    
    # Priority queue to store pairs of (distance, node)
    # Automatically keeps the node with the smallest distance at the top
    priority_queue = [(0, start)]
    
    while priority_queue:
        # Extract the node with the minimum distance
        current_distance, current_node = heapq.heappop(priority_queue)
        
        # Nodes can be added to the queue multiple times with different distances.
        # If we found a shorter path to current_node already, skip this entry.
        if current_distance > distances[current_node]:
            continue
            
        # Explore neighbors of the current node
        for neighbor, weight in graph[current_node]:
            distance = current_distance + weight
            
            # If a shorter path to the neighbor is found, update it
            if distance < distances[neighbor]:
                distances[neighbor] = distance
                # Push the updated path length and neighbor to the queue
                heapq.heappush(priority_queue, (distance, neighbor))
                
    return distances


