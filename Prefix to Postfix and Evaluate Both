def prefix_to_postfix(expr):
    stack = []

    for token in reversed(expr.split()):

        if token.lstrip("-").isdigit():
            stack.append(token)
        else:
            a = stack.pop()
            b = stack.pop()

            stack.append(a + " " + b + " " + token)

    return stack[-1]

def evaluate_prefix(expr):
    stack = []

    for token in reversed(expr.split()):

        if token.lstrip("-").isdigit():
            stack.append(int(token))
        else:
            a = stack.pop()
            b = stack.pop()

            if token == '+':
                stack.append(a + b)
            elif token == '-':
                stack.append(a - b)
            elif token == '*':
                stack.append(a * b)
            elif token == '/':
                stack.append(a / b)

    return stack[-1]

def evaluate_postfix(expr):
    stack = []

    for token in expr.split():

        if token.lstrip("-").isdigit():
            stack.append(int(token))
        else:
            b = stack.pop()
            a = stack.pop()

            if token == '+':
                stack.append(a + b)
            elif token == '-':
                stack.append(a - b)
            elif token == '*':
                stack.append(a * b)
            elif token == '/':
                stack.append(a / b)

    return stack[-1]

expr = input("Enter prefix expression: ")

postfix = prefix_to_postfix(expr)

prefix_result = evaluate_prefix(expr)
postfix_result = evaluate_postfix(postfix)

print("Postfix:", postfix)
print("Prefix Result:", prefix_result)
print("Postfix Result:", postfix_result)

if prefix_result == postfix_result:
    print("Both results are equal")
else:
    print("Results are not equal")
