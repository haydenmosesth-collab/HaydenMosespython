class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

top = None

def push(x):
    global top
    n = Node(x)
    n.next = top
    top = n

def pop():
    global top
    x = top.data
    top = top.next
    return x

def display():
    p = top
    a = []

    while p:
        a.append(p.data)
        p = p.next

    print("Stack:", *a)

expr = input("Enter postfix expression: ").split()

for token in expr:
    if token.lstrip("-").isdigit():
        push(int(token))
    else:
        b = pop()
        a = pop()

        if token == '+':
            push(a + b)
        elif token == '-':
            push(a - b)
        elif token == '*':
            push(a * b)
        elif token == '/':
            push(a / b)

    display()

print("Result:", pop())
