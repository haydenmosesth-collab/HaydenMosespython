def counting_sort_ip(ip_tuples, byte_index):
    """
    Helper function to sort IP tuples based on a specific byte index (0 to 3).
    Uses base-256 counting sort.
    """
    n = len(ip_tuples)
    output = [0] * n
    count = [0] * 256

    # Count occurrences of the specific byte value
    for i in range(n):
        # ip_tuples[i][1] holds the 32-bit integer representation
        # Shift and mask to extract the specific byte
        byte_val = (ip_tuples[i][1] >> (byte_index * 8)) & 0xFF
        count[byte_val] += 1

    # Cumulative count
    for i in range(1, 256):
        count[i] += count[i - 1]

    # Build the output array backwards for stability
    for i in range(n - 1, -1, -1):
        byte_val = (ip_tuples[i][1] >> (byte_index * 8)) & 0xFF
        output[count[byte_val] - 1] = ip_tuples[i]
        count[byte_val] -= 1

    return output


def radix_sort_ips(ip_list):
    """
    Sorts a list of IPv4 address strings using Radix Sort.
    """
    # Step 1: Convert IP strings to (original_string, 32_bit_integer) tuples
    ip_tuples = []
    for ip in ip_list:
        # Split string by '.' and convert each octet to an integer
        octets = list(map(int, ip.split('.')))
        # Bitwise shift to combine into one 32-bit integer
        ip_int = (octets[0] << 24) + (octets[1] << 16) + (octets[2] << 8) + octets[3]
        ip_tuples.append((ip, ip_int))

    # Step 2: Perform Radix Sort across all 4 bytes (from least to most significant)
    for byte_index in range(4):
        ip_tuples = counting_sort_ip(ip_tuples, byte_index)

    # Step 3: Extract the sorted strings
    return [ip[0] for ip in ip_tuples]


