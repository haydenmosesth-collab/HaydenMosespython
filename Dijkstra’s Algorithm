    graph = {
        'A': [('B', 6), ('D', 1)],
        'B': [('A', 6), ('C', 1), ('D', 2), ('E', 2)],
        'C': [('B', 1), ('F', 5)],
        'D': [('A', 1), ('B', 2), ('E', 1)],
        'E': [('B', 2), ('D', 1), ('F', 5)],
        'F': [('C', 5), ('E', 5)]
    }
    
    source_node = 'A'
    shortest_paths = dijkstra(graph, source_node)
    
    print(f"Shortest distances from source node '{source_node}':")
    for target, dist in shortest_paths.items():
        print(f"Distance to node {target} : {dist}")
