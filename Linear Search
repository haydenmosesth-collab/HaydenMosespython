def linear_search(arr, target):
    for i in range(len(arr)):
        if arr[i] == target:
            return i  # Return the index if found
    return -1  # Return -1 if target is not in the list

# Example usage (Works on unsorted arrays):
unsorted_arr = [10, 50, 30, 70, 80, 20]
target_val = 30

result = linear_search(unsorted_arr, target_val)
print(f"Linear Search: Element found at index {result}")
