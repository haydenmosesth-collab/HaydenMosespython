ax, ay = map(int, input().split())
bx, by = map(int, input().split())
cx, cy = map(int, input().split())
dx, dy = map(int, input().split())


def is_on_segment(u, v, p):
  ux, uy = u
  vx, vy = v
  px, py = p

  cross = (vx - ux) * (py - uy) - (vy - uy) * (px - ux)
  if cross != 0:
    return False

  return min(ux, vx) <= px <= max(ux, vx) and min(uy, vy) <= py <= max(uy, vy)


a = (ax, ay)
b = (bx, by)
c = (cx, cy)
d = (dx, dy)

if (
    is_on_segment(a, c, b)
    or is_on_segment(a, c, d)
    or is_on_segment(b, d, a)
    or is_on_segment(b, d, c)
):
  print("yes")
else:
  print("no")
