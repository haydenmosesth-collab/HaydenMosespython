class Node:
    def __init__(self, c, e):
        self.c = c
        self.e = e
        self.next = None

def insert(head, c, e):
    if c == 0:
        return head

    if head is None or e > head.e:
        n = Node(c, e)
        n.next = head
        return n

    p = head

    while p.next and p.next.e > e:
        p = p.next

    if p.next and p.next.e == e:
        p.next.c += c
    else:
        n = Node(c, e)
        n.next = p.next
        p.next = n

    return head

def read():
    head = None
    n = int(input("Number of terms: "))

    for _ in range(n):
        c, e = map(int, input().split())
        head = insert(head, c, e)

    return head

def multiply(a, b):
    result = None

    p = a

    while p:
        q = b

        while q:
            result = insert(
                result,
                p.c * q.c,
                p.e + q.e
            )
            q = q.next

        p = p.next

    return result

def show(p):
    terms = []

    while p:
        if p.c:
            terms.append(
                str(p.c) if p.e == 0
                else f"{p.c}x^{p.e}"
            )
        p = p.next

    print(" + ".join(terms) if terms else "0")

p1 = read()
p2 = read()

print("P1 =", end=" ")
show(p1)

print("P2 =", end=" ")
show(p2)

print("P1 x P2 =", end=" ")
show(multiply(p1, p2))
