stack = []

expr = input("Enter prefix expression: ")

for ch in reversed(expr):

    if ch.isdigit():
        stack.append(int(ch))

    else:
        a = stack.pop()
        b = stack.pop()

        if ch == '+':
            stack.append(a + b)
        elif ch == '-':
            stack.append(a - b)
        elif ch == '*':
            stack.append(a * b)
        elif ch == '/':
            stack.append(a / b)

print("Result:", stack[-1])
