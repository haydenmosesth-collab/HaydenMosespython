from collections import deque

class Queue:
    def __init__(self):
        self.queue = deque()

    def enqueue(self, item):
        self.queue.append(item)
        print(f"Enqueued: {item}")

    def dequeue(self):
        if self.is_empty():
            return "Queue is empty!"
        return f"Dequeued: {self.queue.popleft()}"

    def is_empty(self):
        return len(self.queue) == 0

# Execution
q = Queue()
q.enqueue("Person A")
q.enqueue("Person B")
print(q.dequeue())
print(q.dequeue())
